{
  "name": "prisma-occ-relationmode",
  "private": true,
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "setup": "prisma generate --config prisma.fk.config.ts && prisma generate --config prisma.emulated.config.ts && prisma db push --config prisma.fk.config.ts && prisma db push --config prisma.emulated.config.ts",
    "repro": "tsx repro.ts",
    "db:logs": "docker compose logs --no-log-prefix postgres"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "dotenv": "17.2.3",
    "prisma": "7.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
